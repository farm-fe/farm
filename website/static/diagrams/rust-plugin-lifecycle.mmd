flowchart TD
  accTitle: Farm Rust plugin lifecycle
  accDescr: Initial compilation and watch updates are separate calls. Cache checks are conditional; hooks inside one module do not describe global scheduling.
  config["config<br/>serial"]
  plugin_cache_loaded["plugin_cache_loaded<br/>serial, only plugin cache records present"]
  build_start["build_start<br/>parallel"]
  build_end["build_end<br/>parallel"]
  finish["finish<br/>parallel"]
  write_plugin_cache["write_plugin_cache<br/>serial"]
  Start["Compiler creation"] --> config --> LoadCache{"Persistent cache enabled?"}
  LoadCache -->|yes| plugin_cache_loaded --> build_start
  LoadCache -->|no| build_start
  build_start --> Build["Build module graph<br/>see module pipeline"] --> build_end
  build_end --> Generate["Generate resources<br/>see resource pipeline"] --> finish
  finish --> Seal{"Cache enabled and<br/>evidence valid?"}
  Seal -->|yes| write_plugin_cache --> Done["Compile completed"]
  Seal -->|no| Done
  Event["Watcher / Compiler.update()"] --> Update["Affected module + resource update<br/>separate update lifecycle"]
  Done -. "later change event, not automatic" .-> Event
