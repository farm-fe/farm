{
  "name": "@farmfe/plugin-image",
  "version": "2.0.0",
  "main": "scripts/index.js",
  "types": "scripts/index.d.ts",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/farm-fe/farm",
  "author": "CCherry07 <2405693142@qq.com>",
  "bugs": {
    "url": "https://github.com/farm-fe/farm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farm-fe/farm.git"
  },
  "keywords": [
    "rust",
    "image",
    "farmfe"
  ],
  "napi": {
    "name": "farmfe_plugin_image",
    "triples": {
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-musl",
        "i686-pc-windows-msvc",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./scripts/func.js",
      "types": "./scripts/index.d.ts",
      "default": "./scripts/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "cargo watch -w src -s 'scripts/watch.sh'",
    "bump": "npx changeset version",
    "build": "farm-plugin-tools build --platform -p farmfe_plugin_image --release",
    "prepublishOnly": "farm-plugin-tools prepublish"
  },
  "files": [
    "scripts",
    "options.d.ts"
  ],
  "devDependencies": {
    "@farmfe/plugin-tools": "workspace:*"
  },
  "optionalDependencies": {
    "@farmfe/plugin-image-darwin-arm64": "2.0.0",
    "@farmfe/plugin-image-darwin-x64": "2.0.0",
    "@farmfe/plugin-image-linux-arm64-gnu": "2.0.0",
    "@farmfe/plugin-image-linux-arm64-musl": "2.0.0",
    "@farmfe/plugin-image-linux-x64-gnu": "2.0.0",
    "@farmfe/plugin-image-linux-x64-musl": "2.0.0",
    "@farmfe/plugin-image-win32-arm64-msvc": "2.0.0",
    "@farmfe/plugin-image-win32-ia32-msvc": "2.0.0",
    "@farmfe/plugin-image-win32-x64-msvc": "2.0.0"
  }
}
