{
  "name": "@farmfe/plugin-tailwindcss",
  "version": "2.0.0",
  "description": "Rust-based TailwindCSS plugin for Farm.",
  "main": "scripts/index.js",
  "types": "scripts/index.d.ts",
  "type": "module",
  "license": "MIT",
  "napi": {
    "binaryName": "farm-plugin-tailwindcss",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-musl",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "exports": {
    ".": {
      "import": "./scripts/func.js",
      "types": "./scripts/index.d.ts",
      "default": "./scripts/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../packages/plugin-tools/bin/farm-plugin-tools.mjs build --platform -p farmfe_plugin_tailwindcss --release",
    "build:publish": "cross-env CARGO_PROFILE_RELEASE_LTO=fat CARGO_PROFILE_RELEASE_STRIP=symbols CARGO_PROFILE_RELEASE_PANIC=abort CARGO_PROFILE_RELEASE_OPT_LEVEL=z farm-plugin-tools build --platform --cargo-name farmfe_plugin_tailwindcss -p farmfe_plugin_tailwindcss --release",
    "prepublishOnly": "farm-plugin-tools prepublish"
  },
  "devDependencies": {
    "@farmfe/plugin-tools": "workspace:*"
  },
  "files": [
    "scripts",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@farmfe/plugin-tailwindcss-darwin-arm64": "2.0.0",
    "@farmfe/plugin-tailwindcss-darwin-x64": "2.0.0",
    "@farmfe/plugin-tailwindcss-linux-arm64-gnu": "2.0.0",
    "@farmfe/plugin-tailwindcss-linux-arm64-musl": "2.0.0",
    "@farmfe/plugin-tailwindcss-linux-x64-gnu": "2.0.0",
    "@farmfe/plugin-tailwindcss-linux-x64-musl": "2.0.0",
    "@farmfe/plugin-tailwindcss-win32-arm64-msvc": "2.0.0",
    "@farmfe/plugin-tailwindcss-win32-ia32-msvc": "2.0.0",
    "@farmfe/plugin-tailwindcss-win32-x64-msvc": "2.0.0"
  }
}
