{
  "changesets": [
    {
      "releases": [
        {
          "name": "@farmfe/core",
          "type": "patch"
        }
      ],
      "summary": "Preserve empty and whitespace-only CSS URLs without resolving a nonexistent dependency or panicking during source replacement.",
      "id": "css-empty-url"
    },
    {
      "releases": [
        {
          "name": "@farmfe/core",
          "type": "patch"
        }
      ],
      "summary": "Stop HTML fallback middleware after sending a response, preserving missing-resource fallthrough. Adapted from ErKeLost's contribution in #2179.",
      "id": "friendly-html-response"
    },
    {
      "releases": [
        {
          "name": "@farmfe/core",
          "type": "patch"
        }
      ],
      "summary": "A top-level `module`, `exports`, `farmRequire` or `farmDynamicRequire` binding in an ES module is renamed again, so it no longer collides with the parameters of the module wrapper (`SyntaxError: Identifier 'module' has already been declared`).",
      "id": "module-binding-hygiene"
    },
    {
      "releases": [
        {
          "name": "@farmfe/core",
          "type": "patch"
        }
      ],
      "summary": "Allow an object `server.proxy[*].target`, as http-proxy accepts (for example with `pfx` and `passphrase` for a client certificate). The config schema only accepted a string.",
      "id": "proxy-object-target"
    },
    {
      "releases": [
        {
          "name": "@farmfe/core",
          "type": "patch"
        }
      ],
      "summary": "Tree shaking no longer removes `x++` / `--x` updates and `delete` statements on top-level variables that are read later.",
      "id": "tree-shake-update-delete"
    }
  ],
  "releases": [
