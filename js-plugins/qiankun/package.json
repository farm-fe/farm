{
  "name": "@farmfe/js-plugin-qiankun",
  "version": "1.0.0",
  "description": "farm qiankun plugin",
  "type": "module",
  "main": "./dist/plugin/cjs/qiankun-farm-plugin.cjs",
  "module": "./dist/plugin/esm/qiankun-farm-plugin.mjs",
  "types": "./dist/plugin/qiankun-farm-plugin.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/plugin/qiankun-farm-plugin.d.ts",
        "default": "./dist/plugin/esm/qiankun-farm-plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin/qiankun-farm-plugin.d.cts",
        "default": "./dist/plugin/cjs/qiankun-farm-plugin.cjs"
      },
      "types": "./dist/plugin/qiankun-farm-plugin.d.ts"
    },
    "./helper": {
      "import": {
        "types": "./dist/helper/qiankun-farm-plugin-helper.d.ts",
        "default": "./dist/helper/esm/qiankun-farm-plugin-helper.mjs"
      },
      "require": {
        "types": "./dist/helper/qiankun-farm-plugin-helper.d.cts",
        "default": "./dist/helper/cjs/qiankun-farm-plugin-helper.cjs"
      },
      "types": "./dist/helper/qiankun-farm-plugin-helper.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm run build:plugin && pnpm run build:helper",
    "build:plugin": "farm build && node scripts/prepare-helper-types.mjs --plugin",
    "build:helper": "farm build -c farm-helper.config.ts && node scripts/prepare-helper-types.mjs",
    "type-check": "tsc -p ./tsconfig.json --noEmit"
  },
  "keywords": [
    "farm",
    "qiankun"
  ],
  "dependencies": {
    "cheerio": "1.1.2"
  },
  "devDependencies": {
    "@farmfe/cli": "workspace:*",
    "@farmfe/core": "workspace:*",
    "@farmfe/js-plugin-dts": "workspace:*"
  },
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "license-components.json"
  ]
}
